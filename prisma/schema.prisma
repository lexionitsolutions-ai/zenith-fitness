generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  STAFF
  ADMIN
}

enum PointTransactionType {
  DAILY_VISIT
  TARGET_COMPLETION
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum TargetStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum FitnessGoal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  GENERAL_FITNESS
  BUILD_ENDURANCE
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseType {
  WARM_UP
  STRENGTH
  CARDIO
  CORE
  FINISHER
  BODYWEIGHT
  STEPPER
  DUMBBELL
  BARBELL
  CABLE
  TRX
  MACHINE
  FREE_WEIGHT
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  REPLACED
}

enum ExerciseVideoStatus {
  VERIFIED
  NEEDS_OWNER_CONFIRMATION
  NO_SUITABLE_VIDEO
  NOT_EMBEDDABLE
}

enum MembershipStatus {
  UPCOMING
  ACTIVE
  EXPIRED
  REVIEW_REQUIRED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  OVERPAID
  UNKNOWN
  REVIEW_REQUIRED
}

enum SourceType {
  NEW_ADMISSION
  LEGACY_IMPORT
}

enum MigrationStatus {
  MIGRATED
  UPDATED
  SKIPPED
  WARNING
  FAILED
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
}

model Member {
  id                   String             @id @default(uuid()) @db.Uuid
  admissionId          String             @unique
  fullName             String
  mobileNumber         String?
  originalMobileNumber String?
  gender               String?
  ageAtImport          Int?
  birthDate            DateTime?          @db.Date
  address              String?
  medicalHistory       String?
  qrToken              String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrCodeActive         Boolean            @default(true)
  sourceSheet          String?
  sourceRow            Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User?
  memberships          Membership[]
  pointTransactions    PointTransaction[]
  targets              MemberTarget[]

  @@index([mobileNumber])
}

model User {
  id                       String             @id @default(uuid()) @db.Uuid
  memberId                 String?            @unique @db.Uuid
  member                   Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mobileNumber             String             @unique
  displayName              String?
  pinHash                  String
  mustChangePassword       Boolean            @default(false)
  role                     Role               @default(MEMBER)
  isActive                 Boolean            @default(true)
  mobileVerified           Boolean            @default(false)
  failedLoginCount         Int                @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  awardedPointTransactions PointTransaction[] @relation("PointAwardedBy")
  assignedTargets          MemberTarget[]     @relation("TargetAssignedBy")
  completedTargets         MemberTarget[]     @relation("TargetCompletedBy")
  announcements            Announcement[]
  workoutAssignments       MemberWorkoutAssignment[] @relation("MemberWorkoutAssignments")
  assignedWorkouts         MemberWorkoutAssignment[] @relation("WorkoutAssignedBy")
}

model MembershipPlan {
  id            String       @id @default(uuid()) @db.Uuid
  planCode      String       @unique
  planName      String
  durationDays  Int
  category      String?
  standardPrice Decimal?     @db.Decimal(12, 2)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
}

model Membership {
  id                  String           @id @default(uuid()) @db.Uuid
  memberId            String           @db.Uuid
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId              String?          @db.Uuid
  plan                MembershipPlan?  @relation(fields: [planId], references: [id])
  planDays            Int?
  category            String?
  startDate           DateTime?        @db.Date
  endDate             DateTime?        @db.Date
  totalAmount         Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(12, 2)
  finalAmount         Decimal          @default(0) @db.Decimal(12, 2)
  amountPaid          Decimal          @default(0) @db.Decimal(12, 2)
  pendingAmount       Decimal          @default(0) @db.Decimal(12, 2)
  paymentMode         String?
  paymentStatus       PaymentStatus
  sourcePaymentStatus String?
  membershipStatus    MembershipStatus
  remarks             String?
  sourceSheet         String
  sourceRow           Int
  sourceType          SourceType       @default(LEGACY_IMPORT)
  sourceTimestamp     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([sourceSheet, sourceRow])
  @@index([memberId, membershipStatus])
}

model ImportBatch {
  id             String            @id @default(uuid()) @db.Uuid
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  status         ImportBatchStatus @default(PENDING)
  totalRows      Int               @default(0)
  successfulRows Int               @default(0)
  updatedRows    Int               @default(0)
  skippedRows    Int               @default(0)
  warningRows    Int               @default(0)
  failedRows     Int               @default(0)
  initiatedBy    String
  createdAt      DateTime          @default(now())
  logs           MigrationLog[]
}

model MigrationLog {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @db.Uuid
  batch          ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceSheet    String
  sourceRow      Int
  admissionId    String?
  status         MigrationStatus
  warningMessage String?
  errorMessage   String?
  rawData        Json
  createdAt      DateTime        @default(now())

  @@index([batchId])
}

model PointTransaction {
  id              String               @id @default(uuid()) @db.Uuid
  memberId        String               @db.Uuid
  member          Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  points          Int
  transactionType PointTransactionType
  referenceKey    String?              @unique
  description     String
  awardedByUserId String?              @db.Uuid
  awardedBy       User?                @relation("PointAwardedBy", fields: [awardedByUserId], references: [id])
  businessDate    DateTime             @db.Date
  createdAt       DateTime             @default(now())

  @@index([memberId, createdAt])
  @@index([businessDate, transactionType])
}

model MemberTarget {
  id                String       @id @default(uuid()) @db.Uuid
  memberId          String       @db.Uuid
  member            Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  targetValue       Decimal?     @db.Decimal(12, 2)
  unit              String?
  startDate         DateTime     @db.Date
  dueDate           DateTime     @db.Date
  status            TargetStatus @default(ASSIGNED)
  rewardPoints      Int          @default(250)
  assignedByUserId  String       @db.Uuid
  assignedBy        User         @relation("TargetAssignedBy", fields: [assignedByUserId], references: [id])
  completedByUserId String?      @db.Uuid
  completedBy       User?        @relation("TargetCompletedBy", fields: [completedByUserId], references: [id])
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([memberId, status])
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  message     String?
  imageData   String?   @db.Text
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdById String    @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model Exercise {
  id                 String                @id @default(uuid()) @db.Uuid
  externalId         Int?                  @unique
  slug               String                @unique
  name               String
  category           String?
  location           String?
  description        String?
  instructions       String?               @db.Text
  safetyInstructions String?               @db.Text
  videoUrl           String?
  thumbnailUrl       String?
  primaryMuscles     Json?
  equipment          String?
  difficulty         String?
  movementType       String?
  videoStatus        ExerciseVideoStatus   @default(NEEDS_OWNER_CONFIRMATION)
  youtubeVideoId     String?
  videoTitle         String?
  videoChannel       String?
  videoDuration      String?
  duplicateVideoOfId String?               @db.Uuid
  notes              String?               @db.Text
  exerciseType       ExerciseType
  equipmentType      String?
  stationId          String?               @db.Uuid
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  station            GymStation?           @relation(fields: [stationId], references: [id])
  duplicateVideoOf   Exercise?             @relation("ExerciseVideoDuplicates", fields: [duplicateVideoOfId], references: [id], onDelete: SetNull)
  duplicateVideoChildren Exercise[]         @relation("ExerciseVideoDuplicates")
  candidates         ExerciseVideoCandidate[]
  workoutExercises   WorkoutPlanExercise[]

  @@index([slug])
  @@index([stationId])
  @@index([videoStatus])
  @@index([category])
  @@index([youtubeVideoId])
}

model ExerciseVideoCandidate {
  id          String   @id @default(uuid()) @db.Uuid
  exerciseId  String   @db.Uuid
  youtubeId   String
  title       String?
  channel     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, youtubeId])
  @@index([exerciseId])
}

model GymStation {
  id          String     @id @default(uuid()) @db.Uuid
  stationCode String     @unique
  displayName String
  machineName String?
  location    String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  exercises   Exercise[]

  @@index([stationCode])
}

model WorkoutPlan {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String
  slug        String                    @unique
  level       WorkoutLevel
  description String?
  totalDays   Int
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  days        WorkoutPlanDay[]
  assignments MemberWorkoutAssignment[]

  @@index([level, active])
}

model WorkoutPlanDay {
  id               String                @id @default(uuid()) @db.Uuid
  workoutPlanId    String                @db.Uuid
  dayNumber        Int
  title            String
  description      String?
  estimatedMinutes Int?
  sortOrder        Int
  workoutPlan      WorkoutPlan           @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises        WorkoutPlanExercise[]

  @@unique([workoutPlanId, dayNumber])
  @@index([workoutPlanId, sortOrder])
}

model WorkoutPlanExercise {
  id                  String                   @id @default(uuid()) @db.Uuid
  workoutPlanDayId    String                   @db.Uuid
  exerciseId          String                   @db.Uuid
  sortOrder           Int
  sectionName         String
  sets                Int?
  reps                Int?
  minimumReps         Int?
  maximumReps         Int?
  holdSeconds         Int?
  restSeconds         Int?
  notes               String?
  alternativeGroup    String?
  workoutPlanDay      WorkoutPlanDay           @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  exercise            Exercise                 @relation(fields: [exerciseId], references: [id])
  progress            MemberExerciseProgress[]

  @@unique([workoutPlanDayId, sortOrder])
  @@index([workoutPlanDayId, sortOrder])
  @@index([exerciseId])
}

model MemberWorkoutAssignment {
  id            String                   @id @default(uuid()) @db.Uuid
  memberId      String                   @db.Uuid
  workoutPlanId String                   @db.Uuid
  fitnessGoal   FitnessGoal
  status        AssignmentStatus         @default(ACTIVE)
  assignedAt    DateTime                 @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  assignedById  String?                  @db.Uuid
  currentDay    Int                      @default(1)
  member        User                     @relation("MemberWorkoutAssignments", fields: [memberId], references: [id])
  workoutPlan   WorkoutPlan              @relation(fields: [workoutPlanId], references: [id])
  assignedBy    User?                    @relation("WorkoutAssignedBy", fields: [assignedById], references: [id])
  progress      MemberExerciseProgress[]

  @@index([memberId, status])
  @@index([workoutPlanId])
}

model MemberExerciseProgress {
  id                        String                @id @default(uuid()) @db.Uuid
  memberWorkoutAssignmentId String                @db.Uuid
  workoutPlanExerciseId     String                @db.Uuid
  completed                 Boolean               @default(false)
  completedAt               DateTime?
  actualSets                Int?
  actualReps                Int?
  notes                     String?
  selected                  Boolean               @default(true)
  updatedAt                 DateTime              @updatedAt
  assignment                MemberWorkoutAssignment @relation(fields: [memberWorkoutAssignmentId], references: [id], onDelete: Cascade)
  workoutPlanExercise       WorkoutPlanExercise   @relation(fields: [workoutPlanExerciseId], references: [id])

  @@unique([memberWorkoutAssignmentId, workoutPlanExerciseId])
  @@index([memberWorkoutAssignmentId, completed])
  @@index([workoutPlanExerciseId])
}
